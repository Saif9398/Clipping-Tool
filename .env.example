# Clipping Tool — optional local overrides.
# Blank values use app/config.py defaults. No credentials are bundled.
# Keep .env private; never commit runtime settings or session files.

# Server: defaults to 127.0.0.1:8000
HOST=
PORT=

# Independent local directories: defaults to work/, output/, models/
WORK_DIR=
OUTPUT_DIR=
MODELS_DIR=

# Local scoring is the default and needs no API key.
SCORING_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional single-admin login for a trusted local instance
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PASSWORD_SHA256=
SESSION_SECRET=
SESSION_DAYS=
COOKIE_SECURE=

# Hardware / concurrency: blank uses automatic detection and conservative defaults
WHISPER_MODEL=
WHISPER_COMPUTE=
MAX_SOURCE_HEIGHT=
ANALYSIS_WORKERS=
RENDER_WORKERS=
NVENC_MAX_SESSIONS=
MAX_CONCURRENT_JOBS=

# Rendering / candidate selection
VIDEO_QUALITY=
ZOOM_FACTOR=
MAX_UPSCALE=
LOOK_FILTER=
LOOK_FILTER_CHAIN=
CLIPS_PER_MINUTE=
MIN_CANDIDATES=
MAX_CANDIDATES=
RENDER_CLIP_TIMEOUT_S=
ANALYSIS_TIMEOUT_S=

# Disk / retention: retention is disabled by default
MIN_FREE_GB=
WARN_FREE_GB=
RETENTION_DAYS=
